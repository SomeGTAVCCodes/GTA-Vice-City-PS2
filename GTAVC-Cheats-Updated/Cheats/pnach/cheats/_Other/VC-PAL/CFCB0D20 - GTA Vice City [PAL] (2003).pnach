//--------------------------------------------------------------------------------------------------------------------
//---- Widescreen (Snake356_fix): Info ----
//--------------------------------------------------------------------------------------------------------------------
// * Widescreen (fix by Snake356), author before fix unknown (gamesmaster site?).
// * Converting from NTSC to PAL by TKBS.

// Values;-					||  Instructions;-
//00000000 --> 3C013F9D 	||  add [eax],al 	--> popfd
//03E00008 --> 44810000 	|| 	or [eax],al 	--> add [eax],al
//E78C87F8 --> 46006302 	|| 	clc  			--> add ah,[ebx+00]
//00000000 --> 03E00008 	|| 	add [eax],al 	--> or [eax],al
//00000000 --> E78C87F8 	|| 	add [eax],al 	--> clc
//0C04C8EC --> 0C04C8EB 	|| 	in al,dx 		--> jmp 20243326 	|| 20243326 == add [esi-5C],al
//0C04C8EC --> 0C04C8EE 	|| 	in al,dx 		--> out dx,al
//0C04C8EC --> 0C04C8EE 	|| 	in al,dx 		--> out dx,al

//-- Widescreen (fix by Snake356, ported by TKBS) --
//								//patch=1,EE,001323AC,word,3C013F9D
