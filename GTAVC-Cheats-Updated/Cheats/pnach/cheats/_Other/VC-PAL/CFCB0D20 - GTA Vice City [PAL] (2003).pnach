//---- Visuals: World Render ----
//--------------------------------------------------------------------------------------------------------------------

//See Through Walls: Translucency World (Cars and skybox is lit, buildings translucent) Opacity.	|| Default Value: FFFFFFFF
//patch=1,EE,204B0C00,extended,DFDFDFDF

//[Render Values]
//...								//FF000000 == Unlit World Cars and skybox is lit
//...								//F0000000 == Unlit (Cars and skybox is lit)
//...								//0F000000 == Opacity - Translucency Shaded lit (Cars and skybox is lit) - Increasing the First Byte will Darken the sahding.
//...								//00F00000 == Blue Light	- R,G,B Levels.
//...								//0000F000 == Green Light	- R,G,B Levels.
//...								//F00000F0 == Red Light		- R,G,B Levels.
//...								//BFBFBFBF == Opacity 		- Translucency Effect
//...								//DFDFDFDF == Opacity 		- Nice partial Translucency Effect - Good for seeing where you are, see through walls,  buildings etc.

//Toggle Blood (00 off,  01 on)
//patch=1,EE,204ADF54,extended,00000001

