//Change weather
//Input: Press Select + L1 	=	Change weather 1 - 7
//patch=1,EE,20555060,extended,00000001 // This is our "Main.scm" Custom Change Weather Cheat (1-7) || Actual Weather Number
//patch=1,EE,204E3670,extended,00000001 // This is our "Main.scm" Custom Change Weather Cheat (1-7) || Number DISPLAYED

//Dynamic Brightness Cheat == Comparative of weather num with Menu Option "Brightness".
//...	If aaaaaaaa(WeatherNum Address) == vv01 --> Set aaaaaaaa(brightness Address)  == vvMAX (00000180) || also set bars displayed in menu.

//...			//Adjust Brightness (Menu Option)
//...			//patch=1,EE,204ADB88,extended,0000011C

//TESTED & WORKS.: TODO: need to find actual address for other stuff related to this, specifically the actual in game weather cheat.
//...			//Dynamic Brightness Cheat 			|| IF value @ 20555060 == 0x01 --> Write 0x0180 TO 204ADB88
//...			//... 								|| If weather sunny set brightness Max.
//...			//patch=1,EE,E1010001,extended,00555060
//...			//patch=1,EE,004ADB88,extended,00000180
//...			//
//...			//patch=1,EE,E1010004,extended,00555060
//...			//patch=1,EE,004ADB88,extended,00000100

//Dynamic Brightness Cheat 			|| IF value @ 20555060 == 0x01 --> Write 0x0180 TO 204ADB88
//... 			If weather Sunny set brightness Max -2.
patch=1,EE,E1010001,extended,00555060
patch=1,EE,204ADB88,extended,0000014E
//... 			If weather Extra Sunny set brightness Max.
patch=1,EE,E1010002,extended,00555060
patch=1,EE,204ADB88,extended,00000180
//... 			If weather Cloudy set brightness Max -6.
patch=1,EE,E1010003,extended,00555060
patch=1,EE,204ADB88,extended,000000EA
//... 			If weather Rainy set brightness Max -8.
patch=1,EE,E1010004,extended,00555060
patch=1,EE,204ADB88,extended,000000B8
//... 			If weather Foggy set brightness -4.
patch=1,EE,E1010005,extended,00555060
patch=1,EE,204ADB88,extended,000000D1
//... 			If weather normal 1 (hurricanes off) set brightness Default (max -5).
patch=1,EE,E1010006,extended,00555060
patch=1,EE,204ADB88,extended,00000100
//... 			If weather normal 2  (hurricanes on) set brightness Default (max -5).
patch=1,EE,E1010007,extended,00555060
patch=1,EE,204ADB88,extended,00000100

