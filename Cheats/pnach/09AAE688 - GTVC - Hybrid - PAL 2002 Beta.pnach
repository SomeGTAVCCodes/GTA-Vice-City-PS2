//Line 2 	=	X -FLOAT-
//Line 3 	=	Y -FLOAT-
//Line 4 	=	Z -FLOAT-
//Line 5 	=	H -FLOAT-
//Line 6 	=		- Sometimes this is spawn time etc - depends on parked, heli-pad, garage.
//Line 7 	=		- Sometimes this is spawn time etc - depends on parked, heli-pad, garage.
//Line 8 	=	Damage Proof - 1F -
//Line 9a 	=	Colours 1 (& 2)
//Line 9b 	=	Colours 2 (Stripe)	- +1 Byte
//Line 10 	=   000000FF

