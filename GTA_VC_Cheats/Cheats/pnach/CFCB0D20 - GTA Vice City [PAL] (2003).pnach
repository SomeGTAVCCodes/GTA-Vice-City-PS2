// Ocean Beach - "GARAGE"
//Line 1	=	VH ID 1
//Line 2	=	X
//Line 3	=	Y
//Line 4	=	Z
//Line 5	=	H
//Line 6	=	Spawn Time
//Line 7	=	Immediate Spawn 00000010
//Line 8	=	0000001F = DMG PROOF
//Line 9	=	Colours 1 & 2 || FF014E44
//	Line 9a	=	Colours 1 || FF01|4E|44
//	Line 9b	=	Colours 2 || FFFF01|4E
//Line 10	=	UNKNOWN - 000000FF

// Hyman Condo - "HELI-PAD"
//Line 1	=	VH ID 1
//Line 2	=	X
//Line 3	=	Y
//Line 4	=	Z
//Line 5	=	00000000 = UNKNOWN
//Line 6	=	FFFFFFFF = UNKNOWN		| Possibly (-1, -1)
//Line 7	=	00000010 = Immediate Spawn
//Line 8	=	27010000 = UNKNOWN  - Possibly change of locked, i.e. always unlocked ?
