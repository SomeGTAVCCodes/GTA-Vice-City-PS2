-- Title: Label, Colour, Font
CETrainer_CELabel1.Caption = "GTA: Vice City"
CETrainer_CELabel1.Font.Color = 0x0000FF

-- Cheat Name &amp; Label
-- CETrainer_CELabel2.Caption = "Cars Invisible"
-- CETrainer_CELabel2.Font.Color = 0xFFCAFF

-- Check Box Label
CETrainer_CECheckbox1.Caption = "Cars Invisible"

-- Check Box Function (Our Cheat)
function CETrainer_CECheckbox1Change(sender)
	if sender.checked then
	   writeByte(0x204B1038,1)
	else
	    writeByte(0x204B1038,0)
	end
end

