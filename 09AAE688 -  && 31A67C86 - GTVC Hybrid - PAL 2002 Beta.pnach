//--------------------------------------------------------------------------------------------------------------------
//---- PS2 Beta .elf ----
//--------------------------------------------------------------------------------------------------------------------

//[In-Game] ---- [HARDCODED] ----
//PAD 1 - Debug Menu Toggle: 	== L1+ R1 on the menu screen, or in-game.
//PAD 1 - Wanted Level + Up		== Left, Right, (repeated)				|| LRLRLR
//PAD 1 - Wanted Level - Down	== Up, Down,  (repeated)				|| UDUDUD
//PAD 1 - Health & Money Cheat 	== Up, Right, Down, Left (repeated)		|| U,R,D,L,U,R,D,L,UP || i.e. circle around the D-Pad
//PAD 1 - Weapon Cheat 			== circle around the D-Pad in the opposite direction

//PAD 2 - HUD TOGGLE 			== START
//PAD 2 - Cam Pos & Teleport  	== CIRCLE  / R2 						|| (CAMERA POSITIION = CIRCLE) && (TELEPORT = R2) (to spawn at cam position)
//PAD 2 - mem stats pages		== L1 + L2 + R1 + R2 					|| Use Debug Menu to show/ hide specific stats.
//PAD 2 - show player pos 		== X, Triangle, Square, Cirlce, & R2 	|| Shows coords/ player position && mem

//[In-Game] ---- Debug Mode (ON OR OFF) ----
//PAD 2 - Toggle: debug Mode				== Triangle
//PAD 2 - SPAWN Weapons (infinite ammo).	== DOWN
//PAD 2 - MISSION Select Number +/-.		== LEFT/RIGHT
//PAD 2 - Speed up time.					== R1
//PAD 2 - SPAWN at current mission marker	== R3


//[In-Game] ---- Debug Mode OFF ----
//PAD 1 - SELECT + L1 == Weather	|| Weather: 1-7 (CYCLE) (6 is normal + hurricanes || 7 is normal - No hurricanes)

//[Multi-Cheat Function "extra cheats"]
//PAD 2 - L1 & L2 In Vehicle  == Vehicle colours 1 & 2 + "extra Vehicle cheats"...

// -- [extra Vehicle cheats] --
//-* DMG PROOF; No Upside-Down dmg + nvulnerable Tyres
//-* WaterTight
//-* Shoot fire from below vehicle (add_explosion 1)
//-* Shoot Rocket/ Grenades from vehicle (add_explosion 2)  - Dist approx 15 units Y-axis relative to player heading.
//		^^^if using heli fire explosion spawns at zero point (ground). i.e. you can fly over stuff & spawwn fire.
//-* set_can_respray_car 1

//[In-Game] ---- Debug Mode ON ----
//PAD 2 - R1  					== SPAWN VEHICLE ###	|| increment vh id || //... hold square increment in jumps of 11?...- no need for this..
//PAD 2 - hold x, then press R1	== SPAWN VEHICLE ###	|| decrement vh id ||

//PAD 2 - L1 || L2 				== Toggle: set_everyone_ignore_player | set_police_ignore_player etc
//PAD 2 - SELECT + X 	 		== Clothes 1-12 (CYCLE) + bonus PLAY13 custom.
//PAD 2 - SELECT 				== CleanStreets ON|| OFF - Toggle cars and peds

//-- [Multi-Cheat Function "extra Player cheats"] --
//PAD 1 - L1, L2 && PAD 2 - X && then PAD 1 - R3

// -- [extra Player cheats] --
//-* Toggle Freeze Player (on,off)...
//-* money += 25000
//-* unlock secret garage 1 (docks)
//-* 100 accuracy
//-* fast reload
//-* Fireproof
//-* nitro taxis & bunny hop
//-* infinite sprint
//-* set_char_proofs $player_char immunities BP 1 FP 1 EP 1 CP 1 MP 1
